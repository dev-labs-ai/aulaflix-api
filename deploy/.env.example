# Production settings for deploy/compose.yaml. On the VPS, copy this file to deploy/.env, which git ignores. Nothing
# secret goes here, or anywhere in the environment: every secret is a file, listed below.

# The API image's tag on GHCR: the commit GitHub Actions built. Each deploy rewrites this line before pulling
AULAFLIX_API_TAG=0000000000000000000000000000000000000000

# The secret files, under /srv/aulaflix/secrets/ (directory mode 700, files mode 600), each named after the property it
# sets. Files the API reads belong to uid 10001, the image's user; the others stay root's.
#
#   File                                            Owner  Read by              Holds
#   aulaflix.bff.key                                10001  api, web             BFF key, 32+ characters
#   aulaflix.asaas.api-key                          10001  api                  Asaas production API key ($aact_prod_…)
#   aulaflix.asaas.webhook-token                    10001  api                  Asaas webhook token
#   spring.mail.username                            10001  api                  SES SMTP username
#   spring.mail.password                            10001  api                  SES SMTP password
#   aulaflix.turnstile.secret-key                   10001  api                  Turnstile secret (the web holds the site key)
#   aulaflix.storage.read-only.access-key-id        10001  api, storage-init    storage read-only key
#   aulaflix.storage.read-only.secret-access-key    10001  api, storage-init
#   aulaflix.storage.read-write.access-key-id       10001  api, storage-init    storage read-write key
#   aulaflix.storage.read-write.secret-access-key   10001  api, storage-init
#   spring.datasource.password                      10001  api, postgres        PostgreSQL password
#   aulaflix.waitlist.unsubscribe-key               10001  api                  unsubscribe AES-GCM key: keep it across
#                                                                               redeploys; a new one breaks sent links
#   aulaflix.codes.hmac-key                         10001  api                  HMAC key of the 6-digit codes
#   minio.license                                   root   storage              AIStor Free license
#   storage.root-user                               root   storage, storage-init  AIStor root credentials
#   storage.root-password                           root   storage, storage-init
#
# The web's NUXT_BFF_KEY comes from the same aulaflix.bff.key, which aulaflix-web's Compose file mounts too. If the web
# runs as another user, give that file the web's group and mode 640 (chown 10001:<the web's gid>), rather than more.
