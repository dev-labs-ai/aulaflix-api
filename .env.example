# Settings for the local Compose stack's `full` profile. Copy this file to .env, which git ignores, and adjust.
# Nothing secret goes here, or anywhere in the environment: every secret is a file in ./secrets/ (see the README).

# The aulaflix-web image's tag on GHCR, pinned to the build to rehearse against
AULAFLIX_WEB_TAG=sha-9aeea86

# Cloudflare Turnstile's test site key, which always passes; the API holds the matching test secret
TURNSTILE_SITE_KEY=1x00000000000000000000AA
